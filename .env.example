# ====================================================================
# LEXAID Environment Variables Template
# Copy this file to .env and replace placeholders with your actual keys.
# NEVER commit your .env file containing real secrets to GitHub!
# ====================================================================

# 1. Google Gemini AI (Required for legal assessment & document analysis)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Supabase Project URL (Public)
# Example: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=

# 3. Supabase Anonymous Public Key (Public browser key)
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> anon public
VITE_SUPABASE_ANON_KEY=

# 4. Supabase Service Role Key (Optional Server-Only Secret)
# Used only by the Express backend for administrative tasks (e.g. bypassing RLS)
# WARNING: NEVER prefix this with VITE_ and NEVER expose it in client-side code!
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=

